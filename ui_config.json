{
  "ui_modules": [
    {
      "name": "TestUI",
      "platform": "windows",
      "library_path": "TestUI.dll",
      "main_window_class": "TestMainWindow",
      "priority": 200,
      "enabled": true,
      "settings": {
        "theme": "light"
      }
    },
    {
      "name": "NewWindows",
      "platform": "windows",
      "library_path": "NewWindowsUI.dll",
      "main_window_class": "MainWindow",
      "priority": 100,
      "enabled": true,
      "settings": {
        "theme": "dark",
        "frameless": true,
        "default_size": {
          "width": 1200,
          "height": 800
        }
      }
    },
    {
      "name": "OldWindows",
      "platform": "windows",
      "library_path": "OldWindowsUI.dll",
      "main_window_class": "mainWindow",
      "priority": 50,
      "enabled": true,
      "settings": {
        "theme": "default"
      }
    },
    {
      "name": "Android",
      "platform": "android",
      "main_window_class": "QQmlApplicationEngine",
      "priority": 100,
      "enabled": true,
      "settings": {
        "qml_path": "qrc:/MainWindow/androidMainWindow.qml",
        "style": "Fusion"
      }
    }
  ]
}
